{
  "openapi": "3.1.0",
  "info": {
    "title": "SLSEA Solar Generation API",
    "version": "0.1.0",
    "description": "SLSEA Solar Generation API. Health checks and OpenAPI are public. Stage 4 provides short-lived JWT bearer tokens and jurisdiction-scoped hierarchy reads. The demonstration credentials described in the README are only for a local seeded database."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current API host"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Health",
      "description": "Public process and database readiness checks."
    },
    {
      "name": "Documentation",
      "description": "The implemented API contract."
    },
    {
      "name": "Authentication",
      "description": "Exchange a local credential for a short-lived bearer token."
    },
    {
      "name": "Hierarchy",
      "description": "Analyst-only geography and installation resources filtered by JWT jurisdiction."
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "tags": [
          "Health"
        ],
        "summary": "Check that the API process is running",
        "description": "Reports process liveness without querying the database. A database outage does not make this endpoint fail. Health probes are not cacheable and ignore conditional caching headers so they always report current health.",
        "responses": {
          "200": {
            "description": "The API process is running.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                },
                "example": {
                  "status": "ok",
                  "service": "slsea-solar-api"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "tags": [
          "Health"
        ],
        "summary": "Check database connectivity",
        "description": "Runs a bounded database connectivity check. Connection details and database errors are never returned. This foundation check does not assert that business tables or seed data exist. Health probes are not cacheable and ignore conditional caching headers so they always report current health.",
        "responses": {
          "200": {
            "description": "The database is reachable.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                },
                "example": {
                  "status": "ready",
                  "checks": {
                    "database": "up"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "description": "The database is unavailable or the readiness check timed out.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": {
                    "code": 50301,
                    "message": "Service is not ready",
                    "details": [
                      {
                        "field": "database",
                        "message": "Database is unavailable"
                      }
                    ],
                    "requestId": "7d50a2a4-39a5-46cc-a8ae-a6ccba1d3897"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "tags": [
          "Documentation"
        ],
        "summary": "Read the OpenAPI description",
        "description": "Returns this OpenAPI 3.1 document as JSON. Only implemented foundation endpoints are included.",
        "responses": {
          "200": {
            "description": "The OpenAPI document describing the implemented API.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "openapi",
                    "info",
                    "paths"
                  ],
                  "properties": {
                    "openapi": {
                      "type": "string",
                      "const": "3.1.0"
                    },
                    "info": {
                      "type": "object"
                    },
                    "paths": {
                      "type": "object"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/auth/token": {
      "post": {
        "operationId": "issueToken",
        "tags": [
          "Authentication"
        ],
        "summary": "Issue a bearer token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
