  "components": {
    "headers": {
      "RequestId": {
        "description": "A server-generated UUID for correlating this response with application logs. For errors, it matches error.requestId.",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "7d50a2a4-39a5-46cc-a8ae-a6ccba1d3897"
      },
      "NoStore": {
        "description": "Foundation health, documentation and error responses must not be stored by caches.",
        "required": true,
        "schema": {
          "type": "string",
          "const": "no-store"
        }
      },
      "Allow": {
        "description": "Methods supported by the target resource.",
        "required": true,
        "schema": {
          "type": "string"
        },
        "example": "GET, HEAD, OPTIONS"
      }
    },
    "schemas": {
      "Liveness": {
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "service": {
            "type": "string",
            "const": "slsea-solar-api"
          }
        }
      },
      "Readiness": {
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "const": "ready"
          },
          "checks": {
            "type": "object",
            "required": [
              "database"
            ],
            "additionalProperties": false,
            "properties": {
              "database": {
                "type": "string",
                "const": "up"
              }
            }
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string",
            "description": "The input field or dependency associated with the error, when applicable."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "details",
              "requestId"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "integer",
                "enum": [
                  40001,
                  40401,
                  40501,
                  40601,
                  41301,
                  41501,
                  50001,
                  50301
                ],
                "description": "Numeric application error code; the first three digits identify the HTTP status."
              },
              "message": {
                "type": "string",
                "description": "A safe, human-readable error summary."
              },
              "details": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "description": "Safe error details; an empty array when there is no additional detail."
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "TokenRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "principalType",
          "identifier",
          "password"
        ],
        "properties": {
          "principalType": {
            "type": "string",
            "enum": [
              "analyst",
              "installation"
            ]
          },
          "identifier": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "const": "Bearer"
          },
          "expiresIn": {
            "type": "integer",
            "minimum": 60
          }
        }
      },
      "Collection": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "responses": {
      "InvalidRequest": {
        "description": "40001: The request is invalid, including malformed JSON.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "NotFound": {
        "description": "40401: No resource exists at the requested path. Business endpoints are not implemented in Stage 1.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "40501: The target resource does not support the requested method. See Allow for supported methods.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          },
          "Allow": {
            "$ref": "#/components/headers/Allow"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "NotAcceptable": {
        "description": "40601: The Accept header excludes application/json. The error response uses the standard JSON error representation.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "41301: The request body exceeds the configured size limit.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "41501: The request body has an unsupported media type, character encoding or content encoding.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "50001: An unexpected error occurred. Responses exclude stack traces, credentials and internal diagnostics.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing, invalid or expired credentials.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The authenticated principal lacks the required scope.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Short-lived HS256 token issued by POST /auth/token."
      }
    }
  }
}
