{
  "openapi": "3.1.0",
  "info": {
    "title": "SLSEA Solar Generation API",
    "version": "0.1.0",
    "description": "Stage 1: API foundation. The public health checks and API description are available without authentication. Interactive documentation is available at /docs. Solar resources, database tables, ingestion and JWT authentication are planned for later stages and are not yet available. Business routes will use the /solar/v1.0 prefix. Responses carry a server-generated X-Request-Id and Cache-Control: no-store. Application error codes: 40001 invalid request, 40401 resource not found, 40501 method not allowed, 40601 unacceptable response media type, 41301 request body too large, 41501 unsupported request media type, 50001 internal server error and 50301 service not ready."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current API host"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Health",
      "description": "Public process and database readiness checks."
    },
    {
      "name": "Documentation",
      "description": "The implemented API contract."
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "tags": [
          "Health"
        ],
        "summary": "Check that the API process is running",
        "description": "Reports process liveness without querying the database. A database outage does not make this endpoint fail. Health probes are not cacheable and ignore conditional caching headers so they always report current health.",
        "responses": {
          "200": {
            "description": "The API process is running.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                },
                "example": {
                  "status": "ok",
                  "service": "slsea-solar-api"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "tags": [
          "Health"
        ],
        "summary": "Check database connectivity",
        "description": "Runs a bounded database connectivity check. Connection details and database errors are never returned. This foundation check does not assert that business tables or seed data exist. Health probes are not cacheable and ignore conditional caching headers so they always report current health.",
        "responses": {
          "200": {
            "description": "The database is reachable.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                },
                "example": {
                  "status": "ready",
                  "checks": {
                    "database": "up"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "description": "The database is unavailable or the readiness check timed out.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": {
                    "code": 50301,
                    "message": "Service is not ready",
                    "details": [
                      {
                        "field": "database",
                        "message": "Database is unavailable"
                      }
                    ],
                    "requestId": "7d50a2a4-39a5-46cc-a8ae-a6ccba1d3897"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "tags": [
          "Documentation"
        ],
        "summary": "Read the OpenAPI description",
        "description": "Returns this OpenAPI 3.1 document as JSON. Only implemented foundation endpoints are included.",
        "responses": {
          "200": {
            "description": "The OpenAPI document describing the implemented API.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "openapi",
                    "info",
                    "paths"
                  ],
                  "properties": {
                    "openapi": {
                      "type": "string",
                      "const": "3.1.0"
                    },
                    "info": {
                      "type": "object"
                    },
                    "paths": {
                      "type": "object"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "headers": {
      "RequestId": {
        "description": "A server-generated UUID for correlating this response with application logs. For errors, it matches error.requestId.",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "7d50a2a4-39a5-46cc-a8ae-a6ccba1d3897"
      },
      "NoStore": {
        "description": "Foundation health, documentation and error responses must not be stored by caches.",
        "required": true,
        "schema": {
          "type": "string",
          "const": "no-store"
        }
      },
      "Allow": {
        "description": "Methods supported by the target resource.",
        "required": true,
        "schema": {
          "type": "string"
        },
        "example": "GET, HEAD, OPTIONS"
      }
    },
    "schemas": {
      "Liveness": {
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "service": {
            "type": "string",
            "const": "slsea-solar-api"
          }
        }
      },
      "Readiness": {
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "const": "ready"
          },
          "checks": {
            "type": "object",
            "required": [
              "database"
            ],
            "additionalProperties": false,
            "properties": {
              "database": {
                "type": "string",
                "const": "up"
              }
            }
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string",
            "description": "The input field or dependency associated with the error, when applicable."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "details",
              "requestId"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "integer",
                "enum": [
                  40001,
                  40401,
                  40501,
                  40601,
                  41301,
                  41501,
                  50001,
                  50301
                ],
                "description": "Numeric application error code; the first three digits identify the HTTP status."
              },
              "message": {
                "type": "string",
                "description": "A safe, human-readable error summary."
              },
              "details": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "description": "Safe error details; an empty array when there is no additional detail."
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    },
    "responses": {
      "InvalidRequest": {
        "description": "40001: The request is invalid, including malformed JSON.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "NotFound": {
        "description": "40401: No resource exists at the requested path. Business endpoints are not implemented in Stage 1.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "40501: The target resource does not support the requested method. See Allow for supported methods.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          },
          "Allow": {
            "$ref": "#/components/headers/Allow"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "NotAcceptable": {
        "description": "40601: The Accept header excludes application/json. The error response uses the standard JSON error representation.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "41301: The request body exceeds the configured size limit.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "41501: The request body has an unsupported media type, character encoding or content encoding.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "50001: An unexpected error occurred. Responses exclude stack traces, credentials and internal diagnostics.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    }
  }
}
