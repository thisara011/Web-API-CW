# Copy to .env for local development. The Compose service uses these public
# development fixtures. Replace them when configuring any hosted environment.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://slsea_app:local_app_only@127.0.0.1:5432/slsea
MIGRATION_DATABASE_URL=postgresql://slsea_dev:local_dev_only@127.0.0.1:5432/slsea

# Integration checks use a separate database. Create slsea_test using the README
# setup command before running npm run test:integration.
TEST_DATABASE_URL=postgresql://slsea_dev:local_dev_only@127.0.0.1:5432/slsea_test

# false for the local Compose database. true enables verified TLS; the server
# certificate must be trusted. Do not put TLS options in DATABASE_URL.
DATABASE_SSL=false
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=2000
DB_IDLE_TIMEOUT_MS=30000
LOG_LEVEL=info
